{
  "$schema": "https://evorule.org/schemas/rule_set/v1.0.json",
  "kind": "rule_set",
  "id": "app.consolecloud.agent_audit.auto_approve_gate",
  "rule_id": "agent_auto_approve_gate",
  "version": "0.1.0",
  "description": "Agent 审计 Starter · AI 自动批准门禁 — 提交业务指令 agent_release_check：auto_approved=true（AI 直接放行）→ 转人工确认 + 审计留痕",
  "metadata": {
    "author": "EvoRule Project",
    "license": "CC0-1.0 Universal (Public Domain)",
    "spdx_license_id": "CC0-1.0",
    "provenance": {
      "derived_from": [
        "evorule-console-cloud 首页 Agent 编程审计主线四幕故事线第 3 幕（AI 自动放行被确定性护栏拦截）实物化"
      ],
      "date": "2026-10-20",
      "workstream": "agent-audit-starter",
      "note": "裁决对象=生产者声明的 auto_approved 标志;规则确保 AI 自动批准不能直接生效,必须转人工确认。"
    },
    "deployment": {
      "method": "evorule-server 启动参数 --rules-dir <本目录>;变更后 POST /api/rules/reload 生效"
    },
    "sections": [
      "1. 指令分流(agent_release_check) → 按业务字段分支,set 写入决策字段(字段缺失由 on_missing=error 拒执行,fail-closed;未匹配指令由引擎产生 Error fact,无 noop 收尾)"
    ],
    "constraints": [
      "eq 域显式 on_missing=error:入参缺 auto_approved 声明时拒执行而非默认放行",
      "写路径统一走 __exec__.payload.data 前缀"
    ]
  },
  "transform": [
    {
      "type": "branch",
      "params": {
        "domain": {
          "type": "instruction",
          "instruction_type": "agent_release_check"
        },
        "on_true": [
          {
            "type": "set",
            "params": {
              "attr": "data",
              "operation": "set",
              "value": "__exec__.instruction.params"
            }
          },
          {
            "type": "branch",
            "params": {
              "domain": {
                "type": "eq",
                "path": "__exec__.payload.data.auto_approved",
                "value": true,
                "on_missing": "error"
              },
              "on_true": [
                {
                  "type": "set",
                  "params": {
                    "attr": "__exec__.payload.data.gate_decision",
                    "operation": "set",
                    "value": "require_human_approval"
                  }
                },
                {
                  "type": "set",
                  "params": {
                    "attr": "__exec__.payload.data.gate_note",
                    "operation": "set",
                    "value": "AI 自动批准不允许直接生效，转人工确认并留痕"
                  }
                }
              ],
              "on_false": [
                {
                  "type": "set",
                  "params": {
                    "attr": "__exec__.payload.data.gate_decision",
                    "operation": "set",
                    "value": "allowed"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
