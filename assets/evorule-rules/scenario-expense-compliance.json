{
  "$schema": "https://evorule.org/schemas/rule_set/v1.0.json",
  "kind": "rule_set",
  "id": "app.consolecloud.scenario_expense",
  "rule_id": "scenario.expense_compliance",
  "version": "0.1.0",
  "description": "报销合规判定 — 提交业务指令 expense_compliance_check：复审印发票拒绝；低于 5000 自动通过；否则需主管审批",
  "metadata": {
    "author": "EvoRule Project",
    "license": "CC0-1.0 Universal (Public Domain)",
    "spdx_license_id": "CC0-1.0",
    "provenance": {
      "derived_from": [
        "evorule-console-cloud docs/scenarios/rules (UV-045 社区点火 W2.2)"
      ],
      "date": "2026-09-02",
      "workstream": "UV-045 W2.2 场景示例规则",
      "note": "与 docs/scenarios/rules 中的内核格式同 transform;本文件为 --rules-dir 可装载的 rule_set v1.0 封装;UV-075(2026-09-04)修正 sections 漂移——原第 2 条误称 noop 收尾规则,实际 transform 仅 1 条业务分支"
    },
    "deployment": {
      "method": "evorule-server 启动参数 --rules-dir <本目录>;变更后 POST /api/rules/reload 生效"
    },
    "sections": [
      "1. 业务分支规则:按 payload.data 业务字段分支,set 写入决策字段(唯一规则;未匹配指令由引擎产生 Error fact,fail-fast,无 noop 收尾)"
    ],
    "constraints": [
      "TCB 数据模型无 Float:金额等数值以整数或字符串形态表达",
      "写路径统一走 __exec__.payload.data 前缀"
    ]
  },
  "transform": [
    {
      "type": "branch",
      "params": {
        "domain": {
          "type": "instruction",
          "instruction_type": "expense_compliance_check"
        },
        "on_true": [
          {
            "type": "set",
            "params": {
              "attr": "data",
              "operation": "set",
              "value": "__exec__.instruction.params"
            }
          },
          {
            "type": "branch",
            "params": {
              "domain": {
                "type": "eq",
                "path": "__exec__.payload.data.invoice.duplicate",
                "value": true
              },
              "on_true": [
                {
                  "type": "set",
                  "params": {
                    "attr": "__exec__.payload.data.expense.decision",
                    "operation": "set",
                    "value": "rejected"
                  }
                },
                {
                  "type": "set",
                  "params": {
                    "attr": "__exec__.payload.data.expense.reject_reason",
                    "operation": "set",
                    "value": "发票重复：同一发票号已存在报销记录"
                  }
                }
              ],
              "on_false": [
                {
                  "type": "branch",
                  "params": {
                    "domain": {
                      "type": "lt",
                      "path": "__exec__.payload.data.expense.amount",
                      "value": 5000
                    },
                    "on_true": [
                      {
                        "type": "set",
                        "params": {
                          "attr": "__exec__.payload.data.expense.decision",
                          "operation": "set",
                          "value": "auto_approved"
                        }
                      }
                    ],
                    "on_false": [
                      {
                        "type": "set",
                        "params": {
                          "attr": "__exec__.payload.data.expense.decision",
                          "operation": "set",
                          "value": "manager_approval_needed"
                        }
                      },
                      {
                        "type": "set",
                        "params": {
                          "attr": "__exec__.payload.data.expense.escalate_to",
                          "operation": "set",
                          "value": "部门主管审批队列"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
